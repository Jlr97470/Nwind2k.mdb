                Begin Label
                    Left =2730
                    Top =11085
                    Width =4350
                    Height =1545
                    FontSize =11
                    BorderColor =6697881
                    ForeColor =128
                    Name ="ÉtiquetteTexteEngagement"
                    Caption ="Nos produits sont sélectionnés dans le monde entier pour leur qualité supérieure"
                        ". Si l'un d'eux ne vous donne pas entière satisfaction, n'hésitez pas à nous le "
                        "renvoyer. Nous nous engageons à vous rembourser intégralement."
                End
                Begin Label
                    TextAlign =2
                    Left =30
                    Top =13695
                    Width =9300
                    Height =915
                    FontSize =18
                    ForeColor =8388608
                    Name ="ÉtiquetteTitreTour"
                    Caption ="Les mille et une saveurs du monde\015\012avec Les Comptoirs"
                End
                Begin Label
                    Left =1665
                    Top =14985
                    Width =6045
                    Height =7545
                    FontSize =12
                    ForeColor =8388608
                    Name ="ÉtiquetteParagrapheTour"
                    Caption ="Lorsque les acheteurs des Comptoirs se mirent à la recherche des merveilles gast"
                        "ronomiques du monde, ils en trouvèrent bien plus de sept. Les voici toutes, appé"
                        "tissantes, dans notre catalogue d'automne.\015\012\015\012Les boissons et desser"
                        "ts que nous vous offrons cette saison ne manqueront pas de flatter les palais le"
                        "s plus fins.\015\012\015\012Pour étancher votre soif, vous n'avez que l'embarras"
                        " du choix : exotisme avec notre cervoise tibétaine Chang Tibetan, vigueur avec n"
                        "otre bière blonde Laughing Lumberjack, et la rafraîchissante Lakkalikööri.\015\012"
                        "\015\012Au rayon des douceurs, essayez donc notre Pavlova, mystérieuse meringue "
                        "d'Australie,  nos classiques biscuits au chocolat anglais, nos succulents bonbon"
                        "s au réglisse de Finlande ou même notre spécialité berlinoise, l'incomparable Nu"
                        "NuCa, pâte à tartiner au chocolat-noisette.\015\012\015\012Nos représentants son"
                        "t prêts dès maintenant à prendre vos commandes. Vous trouverez en dernière page "
                        "du présent catalogue un bon de commande et tous les détails nécessaires."
                End
